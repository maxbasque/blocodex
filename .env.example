# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings -> Database -> Connect
DATABASE_URL=            # transaction pooler, port 6543, add ?pgbouncer=true
DATABASE_URL_UNPOOLED=   # direct/session connection, port 5432

# Optional: your Supabase Auth user id, to be marked as admin by `npm run db:seed`
ADMIN_AUTH_ID=
